# Resume Analyzer Pro — Backend Environment Variables
# Copy this to .env and fill in your values

# App
APP_ENV=development
DEBUG=True
SECRET_KEY=your-256-bit-random-secret-key-here

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resume_analyzer

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (Resend — own inbox only unless domain verified)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Resume Analyzer Pro

# Email via Gmail SMTP (delivers to ANY inbox, no domain needed)
# Get App Password: myaccount.google.com/apppasswords (needs 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=you@gmail.com
SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# File Storage (Cloudflare R2 or AWS S3)
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=resume-analyzer
S3_REGION=auto
# For Cloudflare R2:
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# For AWS S3, leave S3_ENDPOINT_URL empty

# Groq AI
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS (add your Vercel URL here)
# ALLOWED_ORIGINS=["http://localhost:5173","https://your-app.vercel.app"]

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:5173

# Sentry (optional)
SENTRY_DSN=
