# ─────────────────────────────────────────────────────────────
# CareerLens AI — Backend Environment Configuration Example
# Copy this file to .env and configure your secrets
# ─────────────────────────────────────────────────────────────

# Application Environment
APP_ENV=development
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-32-char-string
JWT_SECRET_KEY=change-me-to-another-secure-random-32-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Production & CORS Domains
FRONTEND_URL=https://resumetric-1.onrender.com
ALLOWED_ORIGINS=https://resumetric-1.onrender.com,https://resumetric-challengers13.vercel.app,http://localhost:5173

# Database (SQLite default for zero-config; PostgreSQL asyncpg for production)
DATABASE_URL=sqlite+aiosqlite:///./careerlens.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/careerlens

# Groq LLM Intelligence Engine
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Real-Time Email Delivery (Gmail SMTP with Dual SSL/STARTTLS Ports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=CareerLens AI

# Optional Fallback Email Providers
# Brevo HTTPS API:
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Resend API:
RESEND_API_KEY=

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis & Celery (Optional for background processing)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
